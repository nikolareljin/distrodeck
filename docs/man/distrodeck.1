.fi
.SS install-tools
.nf
usage: distrodeck install-tools [-h] [--all] [--tools LIST]
                                [--tools-file PATH] [--reconcile]
                                [--list-tools]

options:
  -h, --help         show this help message and exit
  --all              Install all tools without showing the TUI
  --tools LIST       Install only these tools without showing the TUI (comma
                     or space separated; repeatable)
  --tools-file PATH  Install only the tools listed in PATH, one per line ('-'
                     for stdin)
  --reconcile        With --tools, also uninstall tracked tools outside the
                     requested set
  --list-tools       Print the tool catalog and exit
.fi
.SS git-status
