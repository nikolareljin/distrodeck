#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python_cmd=""

if command -v python3 >/dev/null 2>&1; then
  python_cmd="python3"
elif command -v python >/dev/null 2>&1; then
  python_cmd="python"
fi

if [[ -z "$python_cmd" ]]; then
  echo "error: Python 3.8+ is required but no python3 was found." >&2
  exit 1
fi

if "$python_cmd" - <<'PY' 2>/dev/null; then
import sys
sys.exit(0 if sys.version_info >= (3, 8) else 1)
PY
  exec "$python_cmd" "$script_dir/distrodeck.py" "$@"
fi

os_id=""
if [[ -f /etc/os-release ]]; then
  os_id="$(. /etc/os-release && echo "${ID:-}")"
fi

case "$os_id" in
  ubuntu|debian)
    hint="sudo apt-get update && sudo apt-get install -y python3"
    ;;
  fedora|rhel|centos)
    hint="sudo dnf install -y python3"
    ;;
  arch|manjaro)
    hint="sudo pacman -S --noconfirm python"
    ;;
  opensuse|opensuse-leap|opensuse-tumbleweed)
    hint="sudo zypper install -y python3"
    ;;
  *)
    hint="Install Python 3.8+ using your package manager."
    ;;
esac

echo "error: Python 3.8+ is required." >&2
echo "Upgrade: $hint" >&2
exit 1
